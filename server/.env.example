# Copy to .env and fill in your own values. Never commit a real .env file.
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/devboard
# Optional: Gemini API key for AI project summaries. Leave unset to use the
# local summary fallback — the app works fully without it. Never commit a key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
